@model IEnumerable<InternalMarksSystem.Models.FacultyProfile>
@{
    ViewData["Title"] = "Faculty Management";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h3 class="fw-bold text-dark mb-0">Faculty Directory & Subject Allocations</h3>
        <p class="text-muted small mb-0">Manage professors, associate faculty, designations, and departmental subject assignments</p>
    </div>
    <a asp-action="Create" class="btn btn-academic shadow-sm">
        <i class="bi bi-person-plus-fill me-1"></i> Register Faculty Member
    </a>
</div>

<div class="card card-academic shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-academic align-middle mb-0">
                <thead>
                    <tr>
                        <th>Employee Code</th>
                        <th>Faculty Name</th>
                        <th>Email</th>
                        <th>Department</th>
                        <th>Designation</th>
                        <th>Allocated Subjects</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Any())
                    {
                        @foreach (var f in Model)
                        {
                            <tr>
                                <td>
                                    <span class="badge bg-light text-dark border font-monospace px-2 py-1">@f.EmployeeCode</span>
                                </td>
                                <td class="fw-semibold">@f.FullName</td>
                                <td class="text-muted small">@f.Email</td>
                                <td><span class="badge bg-secondary-subtle text-secondary">@f.Department?.Code</span> @f.Department?.Name</td>
                                <td><span class="badge bg-info-subtle text-info border border-info-subtle">@f.Designation</span></td>
                                <td>
                                    @if (f.AssignedSubjects.Any())
                                    {
                                        <div class="d-flex flex-wrap gap-1">
                                            @foreach (var a in f.AssignedSubjects)
                                            {
                                                <span class="badge bg-primary-subtle text-primary border border-primary-subtle">
                                                    @a.Subject?.SubjectCode
                                                </span>
                                            }
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">None assigned</span>
                                    }
                                </td>
                                <td class="text-end">
                                    <a asp-action="AssignSubject" asp-route-id="@f.Id" class="btn btn-outline-primary btn-sm" title="Assign Subjects">
                                        <i class="bi bi-journal-plus me-1"></i> Assign Subjects
                                    </a>
                                    <a asp-action="Edit" asp-route-id="@f.Id" class="btn btn-outline-secondary btn-sm ms-1" title="Edit Profile">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="text-center text-muted py-4">No faculty profiles found.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
