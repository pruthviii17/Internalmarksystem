@using Microsoft.AspNetCore.Identity
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

@{
    var currentUser = await UserManager.GetUserAsync(User);
    string userRole = "Student";
    if (currentUser != null)
    {
        var roles = await UserManager.GetRolesAsync(currentUser);
        userRole = roles.FirstOrDefault() ?? currentUser.UserRole ?? "Student";
    }
    string currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    string currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Internal Marks Management System</title>

    <!-- Bootstrap 5 CSS -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <!-- Chart.js -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <!-- Custom Academic CSS -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    @if (SignInManager.IsSignedIn(User))
    {
        <div class="app-container">
            <!-- Sidebar Navigation -->
            <aside class="app-sidebar">
                <a asp-controller="Dashboard" asp-action="Index" class="sidebar-brand">
                    <i class="bi bi-mortarboard-fill"></i>
                    <div>
                        <div>MarksPortal</div>
                        <div style="font-size: 0.68rem; font-weight: 400; color: #94a3b8; text-transform: uppercase; letter-spacing: 0.05em;">College Project</div>
                    </div>
                </a>

                <ul class="sidebar-menu">
                    <li class="sidebar-heading">Navigation</li>
                    <li>
                        <a asp-controller="Dashboard" asp-action="Index" class="sidebar-link @(currentController == "Dashboard" ? "active" : "")">
                            <i class="bi bi-speedometer2"></i> Dashboard
                        </a>
                    </li>

                    @if (User.IsInRole("Admin"))
                    {
                        <li class="sidebar-heading">Academic Administration</li>
                        <li>
                            <a asp-controller="Students" asp-action="Index" class="sidebar-link @(currentController == "Students" ? "active" : "")">
                                <i class="bi bi-people-fill"></i> Students
                            </a>
                        </li>
                        <li>
                            <a asp-controller="Subjects" asp-action="Index" class="sidebar-link @(currentController == "Subjects" ? "active" : "")">
                                <i class="bi bi-book-fill"></i> Subjects & Schemes
                            </a>
                        </li>
                        <li>
                            <a asp-controller="Faculty" asp-action="Index" class="sidebar-link @(currentController == "Faculty" ? "active" : "")">
                                <i class="bi bi-person-badge-fill"></i> Faculty & Allocations
                            </a>
                        </li>
                        <li>
                            <a asp-controller="Approval" asp-action="Index" class="sidebar-link @(currentController == "Approval" ? "active" : "")">
                                <i class="bi bi-patch-check-fill"></i> Approvals & Publish
                            </a>
                        </li>
                    }

                    @if (User.IsInRole("Faculty"))
                    {
                        <li class="sidebar-heading">Evaluation</li>
                        <li>
                            <a asp-controller="Dashboard" asp-action="Index" class="sidebar-link">
                                <i class="bi bi-journal-check"></i> Assigned Subjects
                            </a>
                        </li>
                    }

                    @if (User.IsInRole("Student"))
                    {
                        <li class="sidebar-heading">Student Portal</li>
                        <li>
                            <a asp-controller="Marks" asp-action="MyMarks" class="sidebar-link @(currentController == "Marks" && currentAction == "MyMarks" ? "active" : "")">
                                <i class="bi bi-award-fill"></i> My Internal Marks
                            </a>
                        </li>
                    }

                    <li class="sidebar-heading">Analytics & Reports</li>
                    <li>
                        <a asp-controller="Reports" asp-action="Index" class="sidebar-link @(currentController == "Reports" ? "active" : "")">
                            <i class="bi bi-bar-chart-line-fill"></i> Performance Reports
                        </a>
                    </li>

                    @if (User.IsInRole("Admin"))
                    {
                        <li class="sidebar-heading">System Governance</li>
                        <li>
                            <a asp-controller="AuditLogs" asp-action="Index" class="sidebar-link @(currentController == "AuditLogs" ? "active" : "")">
                                <i class="bi bi-clock-history"></i> Audit Trail
                            </a>
                        </li>
                        <li>
                            <a asp-controller="Home" asp-action="Diagnostics" class="sidebar-link @(currentController == "Home" && currentAction == "Diagnostics" ? "active" : "")">
                                <i class="bi bi-clipboard2-check-fill"></i> System Diagnostics
                            </a>
                        </li>
                    }
                </ul>

                <!-- Current User Snapshot -->
                <div class="sidebar-user">
                    <div class="sidebar-user-avatar">
                        @(currentUser?.FullName?.Substring(0, 1).ToUpper() ?? "U")
                    </div>
                    <div class="overflow-hidden">
                        <div class="text-truncate font-weight-bold text-white small" style="max-width: 150px;">
                            @(currentUser?.FullName ?? currentUser?.UserName)
                        </div>
                        <div class="badge bg-primary-subtle text-primary border border-primary-subtle" style="font-size: 0.7rem;">
                            @userRole
                        </div>
                    </div>
                </div>
            </aside>

            <!-- Main Application Area -->
            <div class="app-main">
                <!-- Top Navbar -->
                <header class="app-header">
                    <div class="d-flex align-items-center">
                        <button class="btn btn-outline-secondary btn-sm me-3 d-lg-none" id="sidebarToggle" type="button">
                            <i class="bi bi-list"></i>
                        </button>
                        <span class="badge bg-light text-secondary border py-2 px-3 d-none d-sm-inline-flex align-items-center">
                            <i class="bi bi-calendar3 me-2 text-primary"></i> AY 2024–2025 | Semester 5
                        </span>
                    </div>

                    <div class="header-actions">
                        <!-- Quick Role Switcher for project evaluation -->
                        <div class="dropdown d-none d-md-block">
                            <button class="btn btn-sm btn-outline-primary dropdown-toggle" type="button" data-bs-toggle="dropdown">
                                <i class="bi bi-person-switch me-1"></i> Switch Role Demo
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end shadow-sm">
                                <li>
                                    <form asp-controller="Account" asp-action="QuickLogin" method="post" class="px-2 py-1">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="role" value="admin" />
                                        <button type="submit" class="dropdown-item rounded py-2">
                                            <i class="bi bi-shield-lock-fill text-danger me-2"></i> Admin / HOD
                                        </button>
                                    </form>
                                </li>
                                <li>
                                    <form asp-controller="Account" asp-action="QuickLogin" method="post" class="px-2 py-1">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="role" value="faculty" />
                                        <button type="submit" class="dropdown-item rounded py-2">
                                            <i class="bi bi-person-workspace text-primary me-2"></i> Faculty Member
                                        </button>
                                    </form>
                                </li>
                                <li>
                                    <form asp-controller="Account" asp-action="QuickLogin" method="post" class="px-2 py-1">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="role" value="student" />
                                        <button type="submit" class="dropdown-item rounded py-2">
                                            <i class="bi bi-mortarboard text-success me-2"></i> Student
                                        </button>
                                    </form>
                                </li>
                            </ul>
                        </div>

                        <!-- User Profile Dropdown -->
                        <div class="dropdown">
                            <a href="#" class="d-flex align-items-center text-dark text-decoration-none dropdown-toggle" data-bs-toggle="dropdown">
                                <span class="d-none d-md-inline me-2 fw-semibold text-secondary small">@(currentUser?.FullName)</span>
                                <div class="rounded-circle bg-primary text-white d-flex align-items-center justify-content-center" style="width: 34px; height: 34px; font-size: 0.85rem; font-weight: 600;">
                                    @(currentUser?.FullName?.Substring(0, 1).ToUpper() ?? "U")
                                </div>
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0 mt-2">
                                <li class="px-3 py-2 border-bottom">
                                    <div class="fw-bold text-dark">@(currentUser?.FullName)</div>
                                    <div class="small text-muted">@(currentUser?.Email)</div>
                                    <div class="badge bg-secondary-subtle text-secondary mt-1">@userRole</div>
                                </li>
                                <li><a class="dropdown-item py-2" asp-controller="Account" asp-action="Profile"><i class="bi bi-person me-2"></i> Profile Details</a></li>
                                <li><hr class="dropdown-divider my-1"></li>
                                <li>
                                    <form asp-controller="Account" asp-action="Logout" method="post">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="dropdown-item text-danger py-2">
                                            <i class="bi bi-box-arrow-right me-2"></i> Sign Out
                                        </button>
                                    </form>
                                </li>
                            </ul>
                        </div>
                    </div>
                </header>

                <!-- Body Content -->
                <main class="content-body">
                    <!-- Notifications and Alerts -->
                    @if (TempData["SuccessMessage"] != null)
                    {
                        <div class="alert alert-success alert-dismissible fade show shadow-sm d-flex align-items-center" role="alert">
                            <i class="bi bi-check-circle-fill me-2 fs-5"></i>
                            <div>@TempData["SuccessMessage"]</div>
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    }

                    @if (TempData["ErrorMessage"] != null)
                    {
                        <div class="alert alert-danger alert-dismissible fade show shadow-sm d-flex align-items-center" role="alert">
                            <i class="bi bi-exclamation-triangle-fill me-2 fs-5"></i>
                            <div>@TempData["ErrorMessage"]</div>
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    }

                    @if (TempData["WarningMessage"] != null)
                    {
                        <div class="alert alert-warning alert-dismissible fade show shadow-sm d-flex align-items-center" role="alert">
                            <i class="bi bi-exclamation-circle-fill me-2 fs-5"></i>
                            <div>@TempData["WarningMessage"]</div>
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    }

                    @RenderBody()
                </main>
            </div>
        </div>
    }
    else
    {
        <div class="min-vh-100 bg-light d-flex flex-column justify-content-center py-4">
            <div class="container">
                @if (TempData["ErrorMessage"] != null)
                {
                    <div class="row justify-content-center mb-3">
                        <div class="col-md-5">
                            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                                <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["ErrorMessage"]
                                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                            </div>
                        </div>
                    </div>
                }
                @RenderBody()
            </div>
        </div>
    }

    <!-- Scripts -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
