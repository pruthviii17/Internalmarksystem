@model IEnumerable<InternalMarksSystem.Models.InternalMark>
@{
    var sem = ViewBag.Semester as InternalMarksSystem.Models.Semester;
    var stats = ViewBag.Stats as InternalMarksSystem.Services.SemesterSummaryStats;
    var subjectSummaries = ViewBag.SubjectSummaries as List<InternalMarksSystem.Services.SubjectSummaryStats>;
    ViewData["Title"] = $"Semester Report - {sem?.Name}";
}

<div class="d-flex justify-content-between align-items-center mb-4 no-print">
    <div>
        <h3 class="fw-bold text-dark mb-0">Semester Academic Performance Report</h3>
        <p class="text-muted small mb-0">Consolidated semester internal assessment analytics</p>
    </div>
    <div class="d-flex gap-2 align-items-center">
        <form method="get" asp-action="SemesterReport" class="d-flex align-items-center gap-2">
            <select name="semesterId" asp-items="ViewBag.Semesters" class="form-select form-select-sm" onchange="this.form.submit();"></select>
        </form>
        <button type="button" class="btn btn-outline-primary btn-sm" onclick="window.print();">
            <i class="bi bi-printer me-1"></i> Print Report
        </button>
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-arrow-left me-1"></i> Back
        </a>
    </div>
</div>

@if (stats != null)
{
    <!-- Overall Semester KPI Cards -->
    <div class="row g-3 mb-4">
        <div class="col-sm-6 col-md-3">
            <div class="metric-card">
                <div class="metric-icon bg-primary-subtle text-primary">
                    <i class="bi bi-people-fill"></i>
                </div>
                <div class="metric-value">@stats.TotalStudents</div>
                <div class="metric-label">Enrolled Students</div>
            </div>
        </div>
        <div class="col-sm-6 col-md-3">
            <div class="metric-card">
                <div class="metric-icon bg-info-subtle text-info">
                    <i class="bi bi-calculator"></i>
                </div>
                <div class="metric-value text-info">@stats.OverallAverage.ToString("0.##")</div>
                <div class="metric-label">Semester Overall Average</div>
            </div>
        </div>
        <div class="col-sm-6 col-md-3">
            <div class="metric-card">
                <div class="metric-icon bg-success-subtle text-success">
                    <i class="bi bi-check-circle"></i>
                </div>
                <div class="metric-value text-success">@stats.OverallPassPercentage.ToString("0.##")%</div>
                <div class="metric-label">Overall Pass Rate</div>
            </div>
        </div>
        <div class="col-sm-6 col-md-3">
            <div class="metric-card">
                <div class="metric-icon bg-secondary-subtle text-secondary">
                    <i class="bi bi-journal-text"></i>
                </div>
                <div class="metric-value">@stats.TotalRecords</div>
                <div class="metric-label">Evaluated Course Units</div>
            </div>
        </div>
    </div>
}

<!-- Subject Summaries Breakdown Grid -->
@if (subjectSummaries != null && subjectSummaries.Any())
{
    <h5 class="fw-bold mb-3"><i class="bi bi-diagram-3 text-primary me-2"></i>Subject-Wise Performance Metrics</h5>
    <div class="row g-3 mb-4">
        @foreach (var s in subjectSummaries)
        {
            <div class="col-md-4">
                <div class="card card-academic shadow-sm h-100">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <span class="fw-bold text-dark">@s.SubjectCode</span>
                        <span class="badge bg-primary-subtle text-primary">Avg: @s.AverageScore.ToString("0.##")</span>
                    </div>
                    <div class="card-body p-3">
                        <div class="fw-semibold text-secondary small mb-2">@s.SubjectName</div>
                        <div class="row g-2 text-center small">
                            <div class="col-4 border-end">
                                <div class="text-muted">Highest</div>
                                <div class="fw-bold text-success">@s.HighestScore.ToString("0.##")</div>
                            </div>
                            <div class="col-4 border-end">
                                <div class="text-muted">Lowest</div>
                                <div class="fw-bold text-danger">@s.LowestScore.ToString("0.##")</div>
                            </div>
                            <div class="col-4">
                                <div class="text-muted">Pass Rate</div>
                                <div class="fw-bold text-primary">@s.PassPercentage.ToString("0.##")%</div>
                            </div>
                        </div>
                    </div>
                    <div class="card-footer bg-light p-2 text-end">
                        <a asp-action="SubjectReport" asp-route-subjectId="@s.SubjectId" class="btn btn-outline-primary btn-sm py-0 px-2 small">
                            Analytics &rarr;
                        </a>
                    </div>
                </div>
            </div>
        }
    </div>
}

<!-- All Semester Marks Table -->
<div class="card card-academic shadow-sm">
    <div class="card-header fw-bold">
        <i class="bi bi-table text-primary me-2"></i>All Evaluated Marks in @sem?.Name
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-academic align-middle mb-0">
                <thead>
                    <tr>
                        <th>Enrollment No</th>
                        <th>Student Name</th>
                        <th>Subject Code</th>
                        <th>Subject Name</th>
                        <th>Marks Obtained</th>
                        <th>Percentage</th>
                        <th>Grade</th>
                        <th>Result</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Any())
                    {
                        @foreach (var m in Model)
                        {
                            <tr>
                                <td><code>@m.Student?.EnrollmentNumber</code></td>
                                <td class="fw-semibold">@m.Student?.FullName</td>
                                <td><code>@m.Subject?.SubjectCode</code></td>
                                <td>@m.Subject?.SubjectName</td>
                                <td class="fw-bold text-primary">@m.CalculatedTotal.ToString("0.##") / @m.MaxTotal.ToString("0.#")</td>
                                <td>@m.Percentage.ToString("0.##")%</td>
                                <td><span class="badge badge-grade grade-@(m.Grade.Replace("+", "plus"))">@m.Grade</span></td>
                                <td>
                                    @if (m.IsPass)
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1">Pass</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-2 py-1">Fail</span>
                                    }
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="8" class="text-center text-muted py-4">No published marks in this semester.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
