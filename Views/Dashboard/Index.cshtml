@model InternalMarksSystem.ViewModels.DashboardViewModel
@{
    ViewData["Title"] = $"{Model.UserRole} Dashboard";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold text-dark mb-0">Welcome back, @Model.UserFullName</h3>
        <p class="text-muted small mb-0">Academic Session 2024–2025 &bull; Internal Assessment Management</p>
    </div>
    <div>
        @if (Model.UserRole == "Admin")
        {
            <div class="d-flex gap-2">
                <a asp-controller="Students" asp-action="Create" class="btn btn-outline-primary btn-sm">
                    <i class="bi bi-person-plus me-1"></i> Add Student
                </a>
                <a asp-controller="Subjects" asp-action="Create" class="btn btn-outline-primary btn-sm">
                    <i class="bi bi-journal-plus me-1"></i> Add Subject
                </a>
                <a asp-controller="Approval" asp-action="Index" class="btn btn-primary btn-sm shadow-sm">
                    <i class="bi bi-patch-check me-1"></i> Review Approvals
                </a>
            </div>
        }
    </div>
</div>

@if (Model.UserRole == "Admin")
{
    <!-- Metric Cards for Admin -->
    <div class="row g-3 mb-4">
        <div class="col-sm-6 col-xl-2">
            <div class="metric-card">
                <div class="metric-icon bg-primary-subtle text-primary">
                    <i class="bi bi-people-fill"></i>
                </div>
                <div class="metric-value">@Model.TotalStudents</div>
                <div class="metric-label">Students</div>
            </div>
        </div>
        <div class="col-sm-6 col-xl-2">
            <div class="metric-card">
                <div class="metric-icon bg-info-subtle text-info">
                    <i class="bi bi-book-fill"></i>
                </div>
                <div class="metric-value">@Model.TotalSubjects</div>
                <div class="metric-label">Subjects</div>
            </div>
        </div>
        <div class="col-sm-6 col-xl-2">
            <div class="metric-card">
                <div class="metric-icon bg-success-subtle text-success">
                    <i class="bi bi-person-badge-fill"></i>
                </div>
                <div class="metric-value">@Model.TotalFaculty</div>
                <div class="metric-label">Faculty</div>
            </div>
        </div>
        <div class="col-sm-6 col-xl-2">
            <div class="metric-card">
                <div class="metric-icon bg-secondary-subtle text-secondary">
                    <i class="bi bi-file-earmark-text-fill"></i>
                </div>
                <div class="metric-value">@Model.TotalMarksRecords</div>
                <div class="metric-label">Total Records</div>
            </div>
        </div>
        <div class="col-sm-6 col-xl-2">
            <div class="metric-card">
                <div class="metric-icon bg-warning-subtle text-warning">
                    <i class="bi bi-hourglass-split"></i>
                </div>
                <div class="metric-value text-warning">@Model.PendingApprovals</div>
                <div class="metric-label">Pending Approval</div>
            </div>
        </div>
        <div class="col-sm-6 col-xl-2">
            <div class="metric-card">
                <div class="metric-icon bg-success-subtle text-success">
                    <i class="bi bi-check2-circle"></i>
                </div>
                <div class="metric-value text-success">@Model.PublishedResults</div>
                <div class="metric-label">Published Marks</div>
            </div>
        </div>
    </div>

    <!-- Charts Row -->
    <div class="row g-4 mb-4">
        <div class="col-lg-8">
            <div class="card card-academic h-100">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <span class="fw-bold"><i class="bi bi-bar-chart-fill text-primary me-2"></i>Subject-Wise Class Averages (Out of 50)</span>
                    <span class="badge bg-light text-secondary border">Published Data</span>
                </div>
                <div class="card-body">
                    <canvas id="subjectAvgChart" style="max-height: 280px;"></canvas>
                </div>
            </div>
        </div>
        <div class="col-lg-4">
            <div class="card card-academic h-100">
                <div class="card-header fw-bold">
                    <i class="bi bi-pie-chart-fill text-primary me-2"></i>Pass / Fail Distribution
                </div>
                <div class="card-body d-flex flex-column align-items-center justify-content-center">
                    <canvas id="passFailChart" style="max-height: 220px;"></canvas>
                    <div class="d-flex justify-content-center gap-4 mt-3 small">
                        <span class="text-success fw-bold"><i class="bi bi-circle-fill me-1"></i> Passed: @Model.PassCount</span>
                        <span class="text-danger fw-bold"><i class="bi bi-circle-fill me-1"></i> Failed: @Model.FailCount</span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Quick Actions and Activity Row -->
    <div class="row g-4">
        <div class="col-lg-4">
            <div class="card card-academic h-100">
                <div class="card-header fw-bold">
                    <i class="bi bi-lightning-charge-fill text-warning me-2"></i>Quick Administrative Actions
                </div>
                <div class="card-body">
                    <div class="list-group list-group-flush">
                        <a asp-controller="Students" asp-action="Index" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center px-0 py-2 border-0">
                            <div><i class="bi bi-people me-2 text-primary"></i>Manage Student Enrollments</div>
                            <i class="bi bi-chevron-right text-muted small"></i>
                        </a>
                        <a asp-controller="Subjects" asp-action="Index" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center px-0 py-2 border-0">
                            <div><i class="bi bi-book me-2 text-info"></i>Configure Subject Assessment Weights</div>
                            <i class="bi bi-chevron-right text-muted small"></i>
                        </a>
                        <a asp-controller="Faculty" asp-action="Index" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center px-0 py-2 border-0">
                            <div><i class="bi bi-person-badge me-2 text-success"></i>Assign Subjects to Professors</div>
                            <i class="bi bi-chevron-right text-muted small"></i>
                        </a>
                        <a asp-controller="Approval" asp-action="Index" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center px-0 py-2 border-0">
                            <div><i class="bi bi-patch-check me-2 text-warning"></i>Review Faculty Marks Submissions</div>
                            <i class="bi bi-chevron-right text-muted small"></i>
                        </a>
                        <a asp-controller="Reports" asp-action="Index" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center px-0 py-2 border-0">
                            <div><i class="bi bi-printer me-2 text-secondary"></i>Generate Transcripts & Excel Export</div>
                            <i class="bi bi-chevron-right text-muted small"></i>
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-8">
            <div class="card card-academic h-100">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <span class="fw-bold"><i class="bi bi-clock-history text-primary me-2"></i>Recent System Activity & Audit Trail</span>
                    <a asp-controller="AuditLogs" asp-action="Index" class="small text-decoration-none">View All &rarr;</a>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-academic align-middle mb-0">
                            <thead>
                                <tr>
                                    <th>Action</th>
                                    <th>Performed By</th>
                                    <th>Details</th>
                                    <th>Time</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.RecentActivities.Any())
                                {
                                    @foreach (var log in Model.RecentActivities)
                                    {
                                        <tr>
                                            <td>
                                                <span class="badge bg-light text-dark border">@log.Action</span>
                                            </td>
                                            <td class="small fw-semibold">@log.UserName</td>
                                            <td class="small text-muted text-truncate" style="max-width: 280px;">@log.Details</td>
                                            <td class="small text-secondary">@log.TimestampUtc.ToString("g")</td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="4" class="text-center text-muted py-3">No activity logs recorded yet.</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
}
else if (Model.UserRole == "Faculty")
{
    <!-- Metric Cards for Faculty -->
    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="metric-card">
                <div class="metric-icon bg-primary-subtle text-primary">
                    <i class="bi bi-journal-bookmark-fill"></i>
                </div>
                <div class="metric-value">@Model.AssignedSubjects.Count</div>
                <div class="metric-label">Assigned Subjects</div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="metric-card">
                <div class="metric-icon bg-secondary-subtle text-secondary">
                    <i class="bi bi-pencil-square"></i>
                </div>
                <div class="metric-value">@Model.MyDraftMarksCount</div>
                <div class="metric-label">Draft Marks Records</div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="metric-card">
                <div class="metric-icon bg-warning-subtle text-warning">
                    <i class="bi bi-send-check-fill"></i>
                </div>
                <div class="metric-value text-warning">@Model.MySubmittedMarksCount</div>
                <div class="metric-label">Submitted for Approval</div>
            </div>
        </div>
    </div>

    <!-- Assigned Subjects Table -->
    <div class="card card-academic shadow-sm mb-4">
        <div class="card-header d-flex justify-content-between align-items-center">
            <span class="fw-bold"><i class="bi bi-journal-check text-primary me-2"></i>My Allocated Subjects for Evaluation</span>
            <span class="badge bg-primary">Academic Year 2024-2025</span>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-academic align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Subject Code</th>
                            <th>Subject Name</th>
                            <th>Department</th>
                            <th>Semester</th>
                            <th>Credits</th>
                            <th>Max Marks</th>
                            <th>Status Summary</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.AssignedSubjects.Any())
                        {
                            @foreach (var sub in Model.AssignedSubjects)
                            {
                                int draftCount = sub.InternalMarks.Count(m => m.Status == InternalMarksSystem.Models.MarkStatus.Draft);
                                int submittedCount = sub.InternalMarks.Count(m => m.Status == InternalMarksSystem.Models.MarkStatus.Submitted);
                                int approvedCount = sub.InternalMarks.Count(m => m.Status == InternalMarksSystem.Models.MarkStatus.Approved);
                                int publishedCount = sub.InternalMarks.Count(m => m.Status == InternalMarksSystem.Models.MarkStatus.Published);
                                int rejectedCount = sub.InternalMarks.Count(m => m.Status == InternalMarksSystem.Models.MarkStatus.Rejected);

                                <tr>
                                    <td><span class="badge bg-dark-subtle text-dark font-monospace">@sub.SubjectCode</span></td>
                                    <td class="fw-semibold">@sub.SubjectName</td>
                                    <td>@sub.Department?.Name</td>
                                    <td><span class="badge bg-light text-secondary border">@sub.Semester?.Name</span></td>
                                    <td>@sub.Credits</td>
                                    <td>@sub.MaxInternalMarks.ToString("0.#")</td>
                                    <td>
                                        @if (publishedCount > 0)
                                        {
                                            <span class="badge badge-status badge-published"><i class="bi bi-check-circle"></i> Published</span>
                                        }
                                        else if (approvedCount > 0)
                                        {
                                            <span class="badge badge-status badge-approved"><i class="bi bi-check2-all"></i> Approved</span>
                                        }
                                        else if (submittedCount > 0)
                                        {
                                            <span class="badge badge-status badge-submitted"><i class="bi bi-hourglass-split"></i> Submitted</span>
                                        }
                                        else if (rejectedCount > 0)
                                        {
                                            <span class="badge badge-status badge-rejected"><i class="bi bi-exclamation-circle"></i> Needs Revision</span>
                                        }
                                        else
                                        {
                                            <span class="badge badge-status badge-draft"><i class="bi bi-pencil"></i> In Draft</span>
                                        }
                                    </td>
                                    <td class="text-end">
                                        <a asp-controller="Marks" asp-action="Enter" asp-route-subjectId="@sub.Id" class="btn btn-academic btn-sm">
                                            <i class="bi bi-pencil-fill me-1"></i> Enter / Edit Marks
                                        </a>
                                        <a asp-controller="Reports" asp-action="SubjectReport" asp-route-subjectId="@sub.Id" class="btn btn-outline-secondary btn-sm ms-1">
                                            <i class="bi bi-graph-up"></i>
                                        </a>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="8" class="text-center text-muted py-4">No subjects currently assigned to your faculty profile.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}
else if (Model.UserRole == "Student")
{
    <!-- Student Profile & Performance View -->
    <div class="row g-4 mb-4">
        <div class="col-lg-4">
            <div class="card card-academic h-100">
                <div class="card-header fw-bold">
                    <i class="bi bi-person-vcard text-primary me-2"></i>Student Information
                </div>
                <div class="card-body">
                    <div class="text-center mb-3">
                        <div class="rounded-circle bg-primary text-white d-inline-flex align-items-center justify-content-center shadow-sm" style="width: 60px; height: 60px; font-size: 1.5rem;">
                            @(Model.StudentProfile?.FullName?.Substring(0, 1).ToUpper() ?? "S")
                        </div>
                        <h5 class="fw-bold mt-2 mb-0">@Model.StudentProfile?.FullName</h5>
                        <span class="badge bg-primary-subtle text-primary border border-primary-subtle font-monospace mt-1">@Model.StudentProfile?.EnrollmentNumber</span>
                    </div>

                    <ul class="list-group list-group-flush small">
                        <li class="list-group-item d-flex justify-content-between px-0">
                            <span class="text-muted">Department:</span>
                            <span class="fw-semibold">@Model.StudentProfile?.Department?.Name</span>
                        </li>
                        <li class="list-group-item d-flex justify-content-between px-0">
                            <span class="text-muted">Semester:</span>
                            <span class="fw-semibold">@Model.StudentProfile?.Semester?.Name</span>
                        </li>
                        <li class="list-group-item d-flex justify-content-between px-0">
                            <span class="text-muted">Enrollment Year:</span>
                            <span class="fw-semibold">@Model.StudentProfile?.EnrollmentYear</span>
                        </li>
                        <li class="list-group-item d-flex justify-content-between px-0">
                            <span class="text-muted">Academic Status:</span>
                            <span class="badge bg-success-subtle text-success">Good Standing</span>
                        </li>
                    </ul>

                    <div class="mt-3">
                        <a asp-controller="Reports" asp-action="StudentReport" asp-route-studentId="@Model.StudentProfile?.Id" class="btn btn-outline-primary btn-sm w-100">
                            <i class="bi bi-printer me-1"></i> Print Official Grade Card
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-8">
            <div class="card card-academic h-100">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <span class="fw-bold"><i class="bi bi-award text-primary me-2"></i>Published Internal Examination Results</span>
                    <span class="badge bg-success">Verified & Published</span>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-academic align-middle mb-0">
                            <thead>
                                <tr>
                                    <th>Subject</th>
                                    <th>Credits</th>
                                    <th>Max</th>
                                    <th>Scored</th>
                                    <th>Percentage</th>
                                    <th>Grade</th>
                                    <th>Result</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.StudentPublishedMarks.Any())
                                {
                                    @foreach (var m in Model.StudentPublishedMarks)
                                    {
                                        <tr>
                                            <td>
                                                <div class="fw-semibold">@m.Subject?.SubjectName</div>
                                                <small class="text-muted font-monospace">@m.Subject?.SubjectCode</small>
                                            </td>
                                            <td>@m.Subject?.Credits</td>
                                            <td>@m.MaxTotal.ToString("0.#")</td>
                                            <td class="fw-bold text-primary">@m.CalculatedTotal.ToString("0.##")</td>
                                            <td>@m.Percentage.ToString("0.##")%</td>
                                            <td>
                                                <span class="badge badge-grade grade-@(m.Grade.Replace("+", "plus"))">@m.Grade</span>
                                            </td>
                                            <td>
                                                @if (m.IsPass)
                                                {
                                                    <span class="badge bg-success-subtle text-success border border-success-subtle"><i class="bi bi-check-circle me-1"></i>Pass</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-danger-subtle text-danger border border-danger-subtle"><i class="bi bi-x-circle me-1"></i>Fail</span>
                                                }
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="7" class="text-center text-muted py-4">No internal marks have been published yet for your semester.</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
                @if (Model.StudentPublishedMarks.Any())
                {
                    <div class="card-footer bg-light d-flex justify-content-between align-items-center py-2 px-3 small">
                        <div>
                            <span>Evaluated Subjects: <strong>@Model.StudentTotalSubjectsCount</strong></span>
                            <span class="ms-3">Subjects Cleared: <strong class="text-success">@Model.StudentPassedSubjectsCount</strong></span>
                        </div>
                        <div>
                            <span>Aggregate Percentage: <strong class="text-primary fs-6">@Model.StudentOverallPercentage%</strong></span>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
}

@section Scripts {
    @if (Model.UserRole == "Admin")
    {
        <script>
            // Chart 1: Subject Averages
            const subCtx = document.getElementById('subjectAvgChart');
            if (subCtx) {
                new Chart(subCtx, {
                    type: 'bar',
                    data: {
                        labels: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.SubjectNames)),
                        datasets: [{
                            label: 'Average Score (out of 50)',
                            data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.SubjectAverages)),
                            backgroundColor: 'rgba(30, 58, 138, 0.85)',
                            borderColor: 'rgba(30, 58, 138, 1)',
                            borderWidth: 1,
                            borderRadius: 4
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        scales: {
                            y: {
                                beginAtZero: true,
                                max: 50,
                                ticks: { stepSize: 10 }
                            }
                        }
                    }
                });
            }

            // Chart 2: Pass/Fail Donut
            const pfCtx = document.getElementById('passFailChart');
            if (pfCtx) {
                new Chart(pfCtx, {
                    type: 'doughnut',
                    data: {
                        labels: ['Passed', 'Failed'],
                        datasets: [{
                            data: [@Model.PassCount, @Model.FailCount],
                            backgroundColor: ['#22c55e', '#ef4444'],
                            hoverOffset: 4
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: {
                            legend: { position: 'bottom' }
                        }
                    }
                });
            }
        </script>
    }
}
