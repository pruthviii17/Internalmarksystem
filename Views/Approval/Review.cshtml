@model IEnumerable<InternalMarksSystem.Models.InternalMark>
@{
    var subject = ViewBag.Subject as InternalMarksSystem.Models.Subject;
    ViewData["Title"] = $"Review Submissions - {subject?.SubjectCode}";
    int semId = ViewBag.SemesterId ?? subject?.SemesterId ?? 1;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <div class="d-flex align-items-center gap-2">
            <h3 class="fw-bold text-dark mb-0">Review Faculty Marks Submission</h3>
            <span class="badge bg-light text-dark border font-monospace fs-6">@subject?.SubjectCode</span>
        </div>
        <p class="text-muted small mb-0">
            @subject?.SubjectName &bull; @subject?.Department?.Name &bull; Semester @semId
        </p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-arrow-left me-1"></i> Back to Approvals
        </a>
    </div>
</div>

<!-- Evaluation Summary & Action Header Card -->
<div class="card card-academic shadow-sm mb-4">
    <div class="card-body p-3">
        <div class="row align-items-center">
            <div class="col-md-7">
                <div class="d-flex flex-wrap gap-3 small text-muted">
                    <span><i class="bi bi-person-fill text-primary me-1"></i> Students: <strong>@Model.Count()</strong></span>
                    <span><i class="bi bi-bullseye text-secondary me-1"></i> Max Internal: <strong>@subject?.MaxInternalMarks.ToString("0.#") Marks</strong></span>
                    <span><i class="bi bi-check2-circle text-danger me-1"></i> Passing Threshold: <strong>@subject?.PassingMarks.ToString("0.#") Marks</strong></span>
                </div>
            </div>
            <div class="col-md-5 text-md-end mt-3 mt-md-0 d-flex justify-content-md-end gap-2">
                <!-- Reject Button Triggering Modal -->
                <button type="button" class="btn btn-outline-danger btn-sm px-3" data-bs-toggle="modal" data-bs-target="#rejectModal">
                    <i class="bi bi-x-circle me-1"></i> Reject Submissions
                </button>

                <!-- Approve Form -->
                <form asp-action="Approve" method="post" onsubmit="return confirm('Approve these submitted marks? They will be locked for editing and ready for publication.');">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="subjectId" value="@subject?.Id" />
                    <input type="hidden" name="semesterId" value="@semId" />
                    <button type="submit" class="btn btn-success btn-sm px-4 shadow-sm">
                        <i class="bi bi-check2-all me-1"></i> Approve Marks
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- Review Marks Table -->
<div class="card card-academic shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-academic align-middle mb-0">
                <thead>
                    <tr>
                        <th>Enrollment No</th>
                        <th>Student Name</th>
                        <th>Assessment Breakdown</th>
                        <th>Weighted Total</th>
                        <th>Percentage</th>
                        <th>Grade</th>
                        <th>Result</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Any())
                    {
                        @foreach (var mark in Model)
                        {
                            <tr>
                                <td><code>@mark.Student?.EnrollmentNumber</code></td>
                                <td class="fw-semibold">@mark.Student?.FullName</td>
                                <td>
                                    <div class="d-flex flex-wrap gap-1">
                                        @foreach (var det in mark.Details.OrderBy(d => d.AssessmentComponent?.DisplayOrder))
                                        {
                                            <span class="badge bg-light text-secondary border small">
                                                @det.AssessmentComponent?.Name: <strong>@det.MarksObtained.ToString("0.##")</strong> / @det.AssessmentComponent?.MaxMarks.ToString("0.#")
                                            </span>
                                        }
                                    </div>
                                </td>
                                <td>
                                    <span class="fw-bold text-primary fs-6">@mark.CalculatedTotal.ToString("0.##")</span>
                                    <span class="text-muted small">/ @mark.MaxTotal.ToString("0.#")</span>
                                </td>
                                <td>@mark.Percentage.ToString("0.##")%</td>
                                <td><span class="badge badge-grade grade-@(mark.Grade.Replace("+", "plus"))">@mark.Grade</span></td>
                                <td>
                                    @if (mark.IsPass)
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success-subtle"><i class="bi bi-check-circle me-1"></i>Pass</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger-subtle text-danger border border-danger-subtle"><i class="bi bi-x-circle me-1"></i>Fail</span>
                                    }
                                </td>
                                <td>
                                    <span class="badge badge-status badge-@(mark.Status.ToString().ToLower())">@mark.Status</span>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="8" class="text-center text-muted py-4">No marks records available for review.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Modal for Rejection Reason -->
<div class="modal fade" id="rejectModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <form asp-action="Reject" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="SubjectId" value="@subject?.Id" />
                <input type="hidden" name="SemesterId" value="@semId" />
                <input type="hidden" name="ActionType" value="Reject" />

                <div class="modal-header border-0">
                    <h5 class="modal-title fw-bold text-danger">
                        <i class="bi bi-exclamation-triangle-fill me-2"></i> Reject Marks Submission
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body text-start">
                    <p class="text-muted small">
                        Please provide a clear justification for rejecting the marks. The faculty evaluator will see this reason and be required to adjust the scores before resubmitting.
                    </p>
                    <div class="mb-3">
                        <label for="rejectionReason" class="form-label fw-bold">Rejection Reason / Required Revisions <span class="text-danger">*</span></label>
                        <textarea name="Reason" id="rejectionReason" class="form-control" rows="4" required placeholder="e.g. Please verify test 2 marks for student 2022CSE004; viva component marks appear missing."></textarea>
                    </div>
                </div>
                <div class="modal-footer border-0">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-danger">Confirm Rejection</button>
                </div>
            </form>
        </div>
    </div>
</div>
