@model InternalMarksSystem.ViewModels.LoginViewModel
@{
    ViewData["Title"] = "Sign In";
    Layout = "_Layout";
}

<div class="row justify-content-center">
    <div class="col-md-5 col-lg-4">
        <div class="text-center mb-4">
            <div class="d-inline-flex align-items-center justify-content-center bg-primary text-white rounded-circle shadow-sm mb-3" style="width: 58px; height: 58px;">
                <i class="bi bi-mortarboard-fill fs-3"></i>
            </div>
            <h4 class="fw-bold text-dark mb-1">Marks Management System</h4>
            <p class="text-muted small">Sign in to manage academic evaluations & internal marks</p>
        </div>

        <div class="card card-academic shadow-sm">
            <div class="card-body p-4">
                <form asp-action="Login" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="ReturnUrl" />

                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small" role="alert"></div>

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label">Email Address</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light text-muted"><i class="bi bi-envelope"></i></span>
                            <input asp-for="Email" class="form-control" placeholder="name@college.edu" autofocus />
                        </div>
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Password" class="form-label">Password</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light text-muted"><i class="bi bi-lock"></i></span>
                            <input asp-for="Password" type="password" class="form-control" placeholder="••••••••" />
                        </div>
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>

                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" asp-for="RememberMe" id="rememberMe">
                            <label class="form-check-label text-muted small" for="rememberMe">Remember me</label>
                        </div>
                    </div>

                    <button type="submit" class="btn btn-primary w-100 py-2 fw-semibold shadow-sm">
                        <i class="bi bi-box-arrow-in-right me-1"></i> Sign In
                    </button>
                </form>
            </div>
        </div>

        <!-- Quick One-Click Demo Access Cards -->
        <div class="card card-academic shadow-sm border-dashed">
            <div class="card-body p-3">
                <div class="text-muted small fw-bold text-uppercase mb-2 text-center">
                    <i class="bi bi-lightning-charge-fill text-warning me-1"></i> Quick Demo Logins
                </div>
                <div class="d-grid gap-2">
                    <form asp-action="QuickLogin" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="role" value="admin" />
                        <button type="submit" class="btn btn-outline-danger btn-sm w-100 text-start d-flex justify-content-between align-items-center">
                            <span><i class="bi bi-shield-lock-fill me-2"></i><strong>Admin / HOD</strong> (Full Access)</span>
                            <span class="badge bg-danger-subtle text-danger">Login</span>
                        </button>
                    </form>

                    <form asp-action="QuickLogin" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="role" value="faculty" />
                        <button type="submit" class="btn btn-outline-primary btn-sm w-100 text-start d-flex justify-content-between align-items-center">
                            <span><i class="bi bi-person-workspace me-2"></i><strong>Faculty</strong> (Prof. Rajesh Sharma)</span>
                            <span class="badge bg-primary-subtle text-primary">Login</span>
                        </button>
                    </form>

                    <form asp-action="QuickLogin" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="role" value="student" />
                        <button type="submit" class="btn btn-outline-success btn-sm w-100 text-start d-flex justify-content-between align-items-center">
                            <span><i class="bi bi-mortarboard-fill me-2"></i><strong>Student</strong> (Rahul Verma)</span>
                            <span class="badge bg-success-subtle text-success">Login</span>
                        </button>
                    </form>
                </div>
            </div>
        </div>

        <div class="text-center text-muted small mt-3">
            Internal Examination Marks Management System &copy; 2026
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
