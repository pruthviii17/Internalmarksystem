@{
    ViewData["Title"] = "Access Denied";
}

<div class="row justify-content-center my-5">
    <div class="col-md-6 text-center">
        <div class="card card-academic shadow-sm p-4">
            <div class="text-danger mb-3">
                <i class="bi bi-shield-x fs-1"></i>
            </div>
            <h3 class="fw-bold text-dark">Access Denied</h3>
            <p class="text-muted">You do not have administrative permission to view this resource or perform this action.</p>
            <div class="mt-3">
                <a asp-controller="Dashboard" asp-action="Index" class="btn btn-primary">
                    <i class="bi bi-house-door me-1"></i> Return to Dashboard
                </a>
            </div>
        </div>
    </div>
</div>
