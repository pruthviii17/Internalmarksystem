@model InternalMarksSystem.ViewModels.MarksEntryViewModel
@{
    ViewData["Title"] = $"Enter Marks - {Model.SubjectCode}";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <div class="d-flex align-items-center gap-2">
            <h3 class="fw-bold text-dark mb-0">Internal Examination Marks Entry</h3>
            <span class="badge bg-light text-dark border font-monospace fs-6">@Model.SubjectCode</span>
        </div>
        <p class="text-muted small mb-0">
            @Model.SubjectName &bull; @Model.DepartmentName &bull; @Model.SemesterName (@Model.AcademicYear)
        </p>
    </div>
    <div class="d-flex gap-2">
        <a asp-controller="Reports" asp-action="SubjectReport" asp-route-subjectId="@Model.SubjectId" class="btn btn-outline-info btn-sm">
            <i class="bi bi-graph-up me-1"></i> Subject Analytics
        </a>
        <a asp-controller="Dashboard" asp-action="Index" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-arrow-left me-1"></i> Dashboard
        </a>
    </div>
</div>

<!-- Evaluation Scheme Summary Ribbon -->
<div class="card card-academic shadow-sm mb-3">
    <div class="card-body py-2 px-3">
        <div class="row align-items-center">
            <div class="col-md-7">
                <span class="small text-muted me-3">
                    <i class="bi bi-bullseye text-primary me-1"></i> Max Internal: <strong>@Model.MaxInternalMarks.ToString("0.#") Marks</strong>
                </span>
                <span class="small text-muted me-3">
                    <i class="bi bi-check2-circle text-danger me-1"></i> Passing Threshold: <strong>@Model.PassingMarks.ToString("0.#") Marks</strong>
                </span>
                <span class="small text-muted">
                    <i class="bi bi-diagram-3 text-secondary me-1"></i> Scheme:
                    @string.Join(" + ", Model.Components.Select(c => $"{c.Name} ({c.WeightPercentage:0.#}%)"))
                </span>
            </div>
            <div class="col-md-5 text-md-end mt-2 mt-md-0">
                <span class="small fw-semibold text-secondary me-2">Workflow Status:</span>
                @if (Model.Students.Any(s => s.Status == InternalMarksSystem.Models.MarkStatus.Published))
                {
                    <span class="badge badge-status badge-published"><i class="bi bi-check-circle"></i> Published</span>
                }
                else if (Model.Students.Any(s => s.Status == InternalMarksSystem.Models.MarkStatus.Approved))
                {
                    <span class="badge badge-status badge-approved"><i class="bi bi-check2-all"></i> Approved</span>
                }
                else if (Model.Students.Any(s => s.Status == InternalMarksSystem.Models.MarkStatus.Submitted))
                {
                    <span class="badge badge-status badge-submitted"><i class="bi bi-hourglass-split"></i> Submitted for HOD Review</span>
                }
                else if (Model.Students.Any(s => s.Status == InternalMarksSystem.Models.MarkStatus.Rejected))
                {
                    <span class="badge badge-status badge-rejected"><i class="bi bi-exclamation-triangle"></i> Rejected / Revisions Requested</span>
                }
                else
                {
                    <span class="badge badge-status badge-draft"><i class="bi bi-pencil"></i> Draft Mode</span>
                }
            </div>
        </div>
    </div>
</div>

@if (!string.IsNullOrEmpty(Model.StatusSummary))
{
    <div class="alert @(Model.IsReadOnly ? "alert-secondary" : "alert-primary") py-2 px-3 small d-flex align-items-center mb-3">
        <i class="bi bi-info-circle-fill me-2 fs-6"></i>
        <div>@Model.StatusSummary</div>
    </div>
}

<form asp-action="Save" method="post" id="marksForm">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="SubjectId" />
    <input type="hidden" asp-for="SubjectCode" />
    <input type="hidden" asp-for="SubjectName" />
    <input type="hidden" asp-for="SemesterId" />
    <input type="hidden" asp-for="AcademicYear" />
    <input type="hidden" asp-for="MaxInternalMarks" />
    <input type="hidden" asp-for="PassingMarks" />

    <div class="card card-academic shadow-sm mb-4">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-bordered table-academic align-middle mb-0"
                       id="marksEntryTable"
                       data-max-internal="@Model.MaxInternalMarks"
                       data-passing-marks="@Model.PassingMarks">
                    <thead class="table-light">
                        <tr>
                            <th style="min-width: 140px;">Enrollment No</th>
                            <th style="min-width: 180px;">Student Name</th>
                            @foreach (var comp in Model.Components)
                            {
                                <th class="text-center comp-header"
                                    data-comp-id="@comp.Id"
                                    data-max-marks="@comp.MaxMarks"
                                    data-weight="@comp.WeightPercentage"
                                    style="min-width: 130px;">
                                    <div>@comp.Name</div>
                                    <div class="small fw-normal text-muted" style="font-size: 0.72rem;">
                                        Max: @comp.MaxMarks.ToString("0.#") &bull; Wt: @comp.WeightPercentage.ToString("0.#")%
                                    </div>
                                </th>
                            }
                            <th class="text-center" style="min-width: 110px;">
                                <div>Total Score</div>
                                <div class="small fw-normal text-muted" style="font-size: 0.72rem;">Max @Model.MaxInternalMarks.ToString("0.#")</div>
                            </th>
                            <th class="text-center" style="min-width: 90px;">Percentage</th>
                            <th class="text-center" style="min-width: 80px;">Grade</th>
                            <th class="text-center" style="min-width: 90px;">Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Students.Any())
                        {
                            for (int i = 0; i < Model.Students.Count; i++)
                            {
                                var student = Model.Students[i];
                                <tr>
                                    <td>
                                        <input type="hidden" name="Students[@i].StudentId" value="@student.StudentId" />
                                        <input type="hidden" name="Students[@i].EnrollmentNumber" value="@student.EnrollmentNumber" />
                                        <input type="hidden" name="Students[@i].StudentName" value="@student.StudentName" />
                                        <span class="badge bg-light text-dark border font-monospace px-2 py-1">@student.EnrollmentNumber</span>
                                    </td>
                                    <td class="fw-semibold">@student.StudentName</td>

                                    @foreach (var comp in Model.Components)
                                    {
                                        student.ComponentMarks.TryGetValue(comp.Id, out decimal currentScore);
                                        <td class="text-center">
                                            @if (Model.IsReadOnly)
                                            {
                                                <input type="text"
                                                       class="form-control form-control-sm text-center fw-bold bg-light"
                                                       value="@currentScore.ToString("0.##")"
                                                       disabled />
                                            }
                                            else
                                            {
                                                <input type="number"
                                                       step="0.5"
                                                       min="0"
                                                       max="@comp.MaxMarks"
                                                       name="Students[@i].ComponentMarks[@comp.Id]"
                                                       value="@currentScore.ToString("0.##")"
                                                       class="form-control form-control-sm text-center fw-bold mark-input"
                                                       data-comp-id="@comp.Id"
                                                       required />
                                            }
                                        </td>
                                    }

                                    <td class="text-center fw-bold text-primary calculated-total-cell">
                                        @student.CalculatedTotal.ToString("0.##")
                                    </td>
                                    <td class="text-center percentage-cell">
                                        @student.Percentage.ToString("0.##")%
                                    </td>
                                    <td class="text-center grade-cell">
                                        <span class="badge badge-grade grade-@(student.Grade.Replace("+", "plus"))">@student.Grade</span>
                                    </td>
                                    <td class="text-center pass-status-cell">
                                        @if (student.IsPass)
                                        {
                                            <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1"><i class="bi bi-check-circle me-1"></i>Pass</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-2 py-1"><i class="bi bi-x-circle me-1"></i>Fail</span>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="@(Model.Components.Count + 6)" class="text-center text-muted py-4">
                                    No students enrolled in this semester and department.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        @if (!Model.IsReadOnly && Model.Students.Any())
        {
            <div class="card-footer bg-white border-top p-3 d-flex justify-content-between align-items-center">
                <div class="small text-muted">
                    <i class="bi bi-calculator me-1"></i> Dynamic weighted calculations update automatically as you type.
                </div>
                <div class="d-flex gap-2">
                    <button type="submit" name="submitAction" value="draft" class="btn btn-outline-secondary px-3">
                        <i class="bi bi-floppy me-1"></i> Save as Draft
                    </button>
                    <button type="submit" name="submitAction" value="submit" class="btn btn-primary px-4 shadow-sm" onclick="return confirm('Are you sure you want to submit these marks for HOD approval? Once submitted, marks will be locked until reviewed.');">
                        <i class="bi bi-send-check-fill me-1"></i> Submit for HOD Approval
                    </button>
                </div>
            </div>
        }
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
