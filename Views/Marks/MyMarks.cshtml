@model IEnumerable<InternalMarksSystem.Models.InternalMark>
@{
    ViewData["Title"] = "My Internal Marks";
    var student = ViewBag.Student as InternalMarksSystem.Models.Student;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold text-dark mb-0">My Internal Examination Results</h3>
        <p class="text-muted small mb-0">Verified and published internal continuous assessments</p>
    </div>
    @if (student != null)
    {
        <a asp-controller="Reports" asp-action="StudentReport" asp-route-studentId="@student.Id" class="btn btn-outline-primary btn-sm">
            <i class="bi bi-printer me-1"></i> Print Grade Card
        </a>
    }
</div>

@if (student != null)
{
    <div class="card card-academic shadow-sm mb-4">
        <div class="card-body p-3">
            <div class="row align-items-center">
                <div class="col-md-3">
                    <span class="text-muted small text-uppercase">Student Name</span>
                    <div class="fw-bold fs-6">@student.FullName</div>
                </div>
                <div class="col-md-3">
                    <span class="text-muted small text-uppercase">Enrollment Number</span>
                    <div><span class="badge bg-light text-dark border font-monospace">@student.EnrollmentNumber</span></div>
                </div>
                <div class="col-md-3">
                    <span class="text-muted small text-uppercase">Department</span>
                    <div class="fw-semibold">@student.Department?.Name</div>
                </div>
                <div class="col-md-3">
                    <span class="text-muted small text-uppercase">Semester</span>
                    <div class="fw-semibold">@student.Semester?.Name</div>
                </div>
            </div>
        </div>
    </div>
}

<div class="card card-academic shadow-sm">
    <div class="card-header d-flex justify-content-between align-items-center">
        <span class="fw-bold"><i class="bi bi-award text-primary me-2"></i>Subject-Wise Marks & Grades</span>
        <span class="badge bg-success">Status: Published</span>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-academic align-middle mb-0">
                <thead>
                    <tr>
                        <th>Subject Code</th>
                        <th>Subject Name</th>
                        <th>Credits</th>
                        <th>Component Breakdown</th>
                        <th>Total Internal Score</th>
                        <th>Percentage</th>
                        <th>Grade</th>
                        <th>Result</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Any())
                    {
                        @foreach (var mark in Model)
                        {
                            <tr>
                                <td><code>@mark.Subject?.SubjectCode</code></td>
                                <td class="fw-semibold">@mark.Subject?.SubjectName</td>
                                <td>@mark.Subject?.Credits</td>
                                <td>
                                    <div class="d-flex flex-wrap gap-1">
                                        @foreach (var det in mark.Details.OrderBy(d => d.AssessmentComponent?.DisplayOrder))
                                        {
                                            <span class="badge bg-light text-secondary border small">
                                                @det.AssessmentComponent?.Name: <strong>@det.MarksObtained.ToString("0.##")</strong> / @det.AssessmentComponent?.MaxMarks.ToString("0.#")
                                            </span>
                                        }
                                    </div>
                                </td>
                                <td>
                                    <span class="fw-bold text-primary fs-6">@mark.CalculatedTotal.ToString("0.##")</span>
                                    <span class="text-muted small">/ @mark.MaxTotal.ToString("0.#")</span>
                                </td>
                                <td>@mark.Percentage.ToString("0.##")%</td>
                                <td>
                                    <span class="badge badge-grade grade-@(mark.Grade.Replace("+", "plus"))">@mark.Grade</span>
                                </td>
                                <td>
                                    @if (mark.IsPass)
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1"><i class="bi bi-check-circle me-1"></i>Pass</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-2 py-1"><i class="bi bi-x-circle me-1"></i>Fail</span>
                                    }
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="8" class="text-center text-muted py-4">No published internal marks found for your current semester.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
