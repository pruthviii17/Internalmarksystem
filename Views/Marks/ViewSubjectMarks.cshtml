@model IEnumerable<InternalMarksSystem.Models.InternalMark>
@{
    var subject = ViewBag.Subject as InternalMarksSystem.Models.Subject;
    ViewData["Title"] = $"Marks - {subject?.SubjectCode}";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold text-dark mb-0">Internal Marks Record</h3>
        <p class="text-muted small mb-0">@subject?.SubjectCode - @subject?.SubjectName &bull; Semester @ViewBag.SemesterId</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-controller="Reports" asp-action="SubjectReport" asp-route-subjectId="@subject?.Id" class="btn btn-outline-info btn-sm">
            <i class="bi bi-graph-up me-1"></i> Analytics
        </a>
        <a asp-action="Enter" asp-route-subjectId="@subject?.Id" class="btn btn-academic btn-sm">
            <i class="bi bi-pencil me-1"></i> Edit Mode
        </a>
    </div>
</div>

<div class="card card-academic shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-academic align-middle mb-0">
                <thead>
                    <tr>
                        <th>Enrollment No</th>
                        <th>Student Name</th>
                        <th>Component Scores</th>
                        <th>Total Internal Marks</th>
                        <th>Percentage</th>
                        <th>Grade</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Any())
                    {
                        @foreach (var m in Model)
                        {
                            <tr>
                                <td><code>@m.Student?.EnrollmentNumber</code></td>
                                <td class="fw-semibold">@m.Student?.FullName</td>
                                <td>
                                    <div class="d-flex flex-wrap gap-1">
                                        @foreach (var det in m.Details.OrderBy(d => d.AssessmentComponent?.DisplayOrder))
                                        {
                                            <span class="badge bg-light text-secondary border small">
                                                @det.AssessmentComponent?.Name: <strong>@det.MarksObtained.ToString("0.##")</strong>
                                            </span>
                                        }
                                    </div>
                                </td>
                                <td>
                                    <span class="fw-bold text-primary">@m.CalculatedTotal.ToString("0.##")</span>
                                    <span class="text-muted small">/ @m.MaxTotal.ToString("0.#")</span>
                                </td>
                                <td>@m.Percentage.ToString("0.##")%</td>
                                <td><span class="badge badge-grade grade-@(m.Grade.Replace("+", "plus"))">@m.Grade</span></td>
                                <td>
                                    <span class="badge badge-status badge-@(m.Status.ToString().ToLower())">@m.Status</span>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="text-center text-muted py-4">No marks entered yet for this subject.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
