@model InternalMarksSystem.Models.Student
@{
    ViewData["Title"] = "Student Details";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card card-academic shadow-sm mb-4">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span class="fw-bold"><i class="bi bi-person-badge text-primary me-2"></i> Student Academic Dossier</span>
                <div class="d-flex gap-2">
                    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-primary btn-sm"><i class="bi bi-pencil me-1"></i> Edit</a>
                    <a asp-action="Index" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-left me-1"></i> Back</a>
                </div>
            </div>
            <div class="card-body p-4">
                <div class="row g-4 mb-4">
                    <div class="col-sm-6">
                        <label class="form-label text-muted small text-uppercase">Full Name</label>
                        <div class="fs-5 fw-bold text-dark">@Model.FullName</div>
                    </div>
                    <div class="col-sm-6">
                        <label class="form-label text-muted small text-uppercase">Enrollment Number</label>
                        <div><span class="badge bg-light text-dark border font-monospace fs-6 px-3 py-1">@Model.EnrollmentNumber</span></div>
                    </div>
                    <div class="col-sm-6">
                        <label class="form-label text-muted small text-uppercase">Email</label>
                        <div>@Model.Email</div>
                    </div>
                    <div class="col-sm-6">
                        <label class="form-label text-muted small text-uppercase">Department</label>
                        <div class="fw-semibold">@Model.Department?.Name (@Model.Department?.Code)</div>
                    </div>
                    <div class="col-sm-6">
                        <label class="form-label text-muted small text-uppercase">Current Semester</label>
                        <div class="fw-semibold">@Model.Semester?.Name</div>
                    </div>
                    <div class="col-sm-6">
                        <label class="form-label text-muted small text-uppercase">Enrollment Year</label>
                        <div class="fw-semibold">@Model.EnrollmentYear</div>
                    </div>
                </div>

                <div class="d-flex justify-content-end">
                    <a asp-controller="Reports" asp-action="StudentReport" asp-route-studentId="@Model.Id" class="btn btn-academic">
                        <i class="bi bi-award me-1"></i> View Full Grade Card
                    </a>
                </div>
            </div>
        </div>

        <!-- Registered Internal Marks History -->
        <div class="card card-academic shadow-sm">
            <div class="card-header fw-bold">
                <i class="bi bi-journal-text text-primary me-2"></i>Internal Marks Overview
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-academic align-middle mb-0">
                        <thead>
                            <tr>
                                <th>Subject Code</th>
                                <th>Subject Name</th>
                                <th>Scored</th>
                                <th>Max</th>
                                <th>Grade</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.InternalMarks.Any())
                            {
                                @foreach (var m in Model.InternalMarks)
                                {
                                    <tr>
                                        <td><code>@m.Subject?.SubjectCode</code></td>
                                        <td class="fw-semibold">@m.Subject?.SubjectName</td>
                                        <td class="fw-bold text-primary">@m.CalculatedTotal.ToString("0.##")</td>
                                        <td>@m.MaxTotal.ToString("0.#")</td>
                                        <td><span class="badge badge-grade grade-@(m.Grade.Replace("+", "plus"))">@m.Grade</span></td>
                                        <td>
                                            <span class="badge badge-status badge-@(m.Status.ToString().ToLower())">@m.Status</span>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="6" class="text-center text-muted py-3">No internal mark records generated yet.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
