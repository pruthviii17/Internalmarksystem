@model IEnumerable<InternalMarksSystem.Models.Student>
@{
    ViewData["Title"] = "Student Management";
    int currentPage = ViewBag.CurrentPage ?? 1;
    int totalPages = ViewBag.TotalPages ?? 1;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h3 class="fw-bold text-dark mb-0">Student Management</h3>
        <p class="text-muted small mb-0">Manage enrolled students, academic departments, and semester assignments</p>
    </div>
    @if (User.IsInRole("Admin"))
    {
        <a asp-action="Create" class="btn btn-academic shadow-sm">
            <i class="bi bi-person-plus-fill me-1"></i> Register New Student
        </a>
    }
</div>

<!-- Search and Filter Bar -->
<div class="card card-academic shadow-sm mb-4">
    <div class="card-body p-3">
        <form method="get" asp-action="Index" class="row g-2 align-items-center">
            <div class="col-md-4">
                <div class="input-group">
                    <span class="input-group-text bg-light text-muted"><i class="bi bi-search"></i></span>
                    <input type="text" name="search" class="form-control" placeholder="Search by name, enrollment number, or email..." value="@ViewBag.CurrentSearch" />
                </div>
            </div>
            <div class="col-md-3">
                <select name="departmentId" asp-items="ViewBag.Departments" class="form-select">
                    <option value="">-- All Departments --</option>
                </select>
            </div>
            <div class="col-md-3">
                <select name="semesterId" asp-items="ViewBag.Semesters" class="form-select">
                    <option value="">-- All Semesters --</option>
                </select>
            </div>
            <div class="col-md-2 d-flex gap-2">
                <button type="submit" class="btn btn-primary w-100">
                    <i class="bi bi-funnel-fill me-1"></i> Filter
                </button>
                <a asp-action="Index" class="btn btn-outline-secondary" title="Reset Filters">
                    <i class="bi bi-arrow-counterclockwise"></i>
                </a>
            </div>
        </form>
    </div>
</div>

<!-- Students Data Table -->
<div class="card card-academic shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-academic align-middle mb-0">
                <thead>
                    <tr>
                        <th>Enrollment No</th>
                        <th>Student Name</th>
                        <th>Email</th>
                        <th>Department</th>
                        <th>Semester</th>
                        <th>Year</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Any())
                    {
                        @foreach (var student in Model)
                        {
                            <tr>
                                <td>
                                    <span class="badge bg-light text-dark border font-monospace px-2 py-1">@student.EnrollmentNumber</span>
                                </td>
                                <td class="fw-semibold">@student.FullName</td>
                                <td class="text-muted small">@student.Email</td>
                                <td><span class="badge bg-secondary-subtle text-secondary">@student.Department?.Code</span> @student.Department?.Name</td>
                                <td><span class="badge bg-info-subtle text-info border border-info-subtle">@student.Semester?.Name</span></td>
                                <td>@student.EnrollmentYear</td>
                                <td class="text-end">
                                    <a asp-action="Details" asp-route-id="@student.Id" class="btn btn-outline-info btn-sm" title="View Profile">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                    @if (User.IsInRole("Admin"))
                                    {
                                        <a asp-action="Edit" asp-route-id="@student.Id" class="btn btn-outline-primary btn-sm ms-1" title="Edit Student">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        <button type="button" class="btn btn-outline-danger btn-sm ms-1" data-bs-toggle="modal" data-bs-target="#deleteModal-@student.Id" title="Delete Student">
                                            <i class="bi bi-trash"></i>
                                        </button>

                                        <!-- Delete Confirmation Modal -->
                                        <div class="modal fade" id="deleteModal-@student.Id" tabindex="-1" aria-hidden="true">
                                            <div class="modal-dialog modal-dialog-centered">
                                                <div class="modal-content">
                                                    <div class="modal-header border-0">
                                                        <h5 class="modal-title fw-bold text-danger"><i class="bi bi-exclamation-triangle-fill me-2"></i> Confirm Student Deletion</h5>
                                                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                                    </div>
                                                    <div class="modal-body text-start">
                                                        Are you sure you want to delete student <strong>@student.FullName</strong> (Enrollment: <code>@student.EnrollmentNumber</code>)?
                                                        <div class="alert alert-warning mt-3 py-2 small mb-0">
                                                            This action cannot be undone. Any draft marks associated with this student will also be removed.
                                                        </div>
                                                    </div>
                                                    <div class="modal-footer border-0">
                                                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                                                        <form asp-action="Delete" asp-route-id="@student.Id" method="post">
                                                            @Html.AntiForgeryToken()
                                                            <button type="submit" class="btn btn-danger">Confirm Delete</button>
                                                        </form>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                    <a asp-controller="Reports" asp-action="StudentReport" asp-route-studentId="@student.Id" class="btn btn-outline-secondary btn-sm ms-1" title="View Grade Card">
                                        <i class="bi bi-award"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="text-center text-muted py-4">No student records found matching the criteria.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
    @if (totalPages > 1)
    {
        <div class="card-footer bg-white border-top d-flex justify-content-between align-items-center py-2 px-3">
            <span class="small text-muted">Showing page @currentPage of @totalPages (Total: @ViewBag.TotalItems)</span>
            <ul class="pagination pagination-sm mb-0">
                @for (int p = 1; p <= totalPages; p++)
                {
                    <li class="page-item @(p == currentPage ? "active" : "")">
                        <a class="page-link" asp-action="Index" asp-route-page="@p" asp-route-search="@ViewBag.CurrentSearch" asp-route-departmentId="@ViewBag.CurrentDepartmentId" asp-route-semesterId="@ViewBag.CurrentSemesterId">@p</a>
                    </li>
                }
            </ul>
        </div>
    }
</div>
