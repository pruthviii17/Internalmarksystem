@model InternalMarksSystem.Models.Subject
@{
    ViewData["Title"] = $"{Model.SubjectCode} - Details";
}

<div class="row justify-content-center">
    <div class="col-lg-9">
        <div class="card card-academic shadow-sm mb-4">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span class="fw-bold"><i class="bi bi-book-half text-primary me-2"></i> Subject Overview</span>
                <div class="d-flex gap-2">
                    <a asp-action="ConfigureComponents" asp-route-id="@Model.Id" class="btn btn-warning btn-sm">
                        <i class="bi bi-sliders me-1"></i> Configure Weights
                    </a>
                    <a asp-controller="Marks" asp-action="Enter" asp-route-subjectId="@Model.Id" class="btn btn-primary btn-sm">
                        <i class="bi bi-pencil-fill me-1"></i> Enter Marks
                    </a>
                    <a asp-action="Index" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-left me-1"></i> Back</a>
                </div>
            </div>
            <div class="card-body p-4">
                <div class="row g-4 mb-3">
                    <div class="col-sm-4">
                        <label class="form-label text-muted small text-uppercase">Subject Code</label>
                        <div class="fs-5 fw-bold text-dark font-monospace">@Model.SubjectCode</div>
                    </div>
                    <div class="col-sm-8">
                        <label class="form-label text-muted small text-uppercase">Subject Title</label>
                        <div class="fs-5 fw-bold text-dark">@Model.SubjectName</div>
                    </div>
                    <div class="col-sm-4">
                        <label class="form-label text-muted small text-uppercase">Department</label>
                        <div class="fw-semibold">@Model.Department?.Name (@Model.Department?.Code)</div>
                    </div>
                    <div class="col-sm-4">
                        <label class="form-label text-muted small text-uppercase">Semester</label>
                        <div class="fw-semibold">@Model.Semester?.Name</div>
                    </div>
                    <div class="col-sm-4">
                        <label class="form-label text-muted small text-uppercase">Credits</label>
                        <div class="fw-semibold">@Model.Credits</div>
                    </div>
                    <div class="col-sm-4">
                        <label class="form-label text-muted small text-uppercase">Max Internal Marks</label>
                        <div class="fw-bold fs-5 text-primary">@Model.MaxInternalMarks.ToString("0.#")</div>
                    </div>
                    <div class="col-sm-4">
                        <label class="form-label text-muted small text-uppercase">Passing Marks</label>
                        <div class="fw-bold fs-5 text-danger">@Model.PassingMarks.ToString("0.#")</div>
                    </div>
                    <div class="col-sm-4">
                        <label class="form-label text-muted small text-uppercase">Assigned Faculty</label>
                        <div>
                            @if (Model.FacultyAssignments.Any())
                            {
                                @foreach (var fa in Model.FacultyAssignments)
                                {
                                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle p-2">
                                        <i class="bi bi-person-check me-1"></i> @fa.FacultyProfile?.FullName
                                    </span>
                                }
                            }
                            else
                            {
                                <span class="badge bg-warning-subtle text-warning p-2">Not Assigned</span>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Assessment Components Breakdown Card -->
        <div class="card card-academic shadow-sm">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span class="fw-bold"><i class="bi bi-pie-chart text-primary me-2"></i> Configured Assessment Components</span>
                <span class="badge bg-light text-secondary border">Total Weight: @Model.AssessmentComponents.Sum(c => c.WeightPercentage).ToString("0.##")%</span>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-academic align-middle mb-0">
                        <thead>
                            <tr>
                                <th>#</th>
                                <th>Assessment Component</th>
                                <th>Maximum Marks</th>
                                <th>Weight Percentage</th>
                                <th>Effective Marks Contribution</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.AssessmentComponents.Any())
                            {
                                int idx = 1;
                                @foreach (var c in Model.AssessmentComponents)
                                {
                                    decimal effectiveMarks = (c.WeightPercentage / 100m) * Model.MaxInternalMarks;
                                    <tr>
                                        <td>@idx++</td>
                                        <td class="fw-semibold">@c.Name</td>
                                        <td>@c.MaxMarks.ToString("0.#")</td>
                                        <td><span class="badge bg-primary-subtle text-primary">@c.WeightPercentage.ToString("0.##")%</span></td>
                                        <td class="fw-bold text-secondary">@effectiveMarks.ToString("0.##") marks</td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="5" class="text-center text-muted py-3">No components configured yet. Click 'Configure Weights' to set them up.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
